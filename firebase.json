{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "bin/**",
      "votcenter/**",
      "dist/**",
      "App_Update_Package/**",
      "pdf_generate/**",
      "*.bat",
      "*.py",
      "main.js",
      "preload.js"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}